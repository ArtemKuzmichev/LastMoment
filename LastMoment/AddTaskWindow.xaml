<Window x:Class="LastMoment.AddTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LastMoment"
        mc:Ignorable="d"
        Title="AddTaskWindow" Height="400" Width="300">
    <Grid>
        <TextBlock Margin="10,9,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">Описание задачи</TextBlock>
        <TextBox Name="Description" Margin="10,33,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="200" Height="100"/>

        <TextBlock Margin="10,143,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">Дата сдачи задачи</TextBlock>
        <DatePicker Name="Date" Margin="10,164,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="150"/>

        <TextBlock Margin="10,220,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">Уровень важности задачи:</TextBlock>
        <TextBlock Margin="10,240,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">(1 - низкий, 5 - высокий)</TextBlock>
        <ComboBox Name="Importance"  Margin="170,220,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
            <ComboBoxItem Content="1" />
            <ComboBoxItem Content="2" />
            <ComboBoxItem Content="3" />
            <ComboBoxItem Content="4" />
            <ComboBoxItem Content="5" />
        </ComboBox>

        <TextBlock Margin="10,280,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">Количество дней на выполнение задачи:</TextBlock>
        <TextBox Name="Days" Margin="240,280,20,0" VerticalAlignment="Top" PreviewTextInput="IsDigital" />

        <Button Name="SaveClose" Margin="10,320,10,10" Click="SaveAndClose">
            <TextBlock>Сохранить и закрыть окно</TextBlock>
        </Button>
    </Grid>
</Window>
